import hashlib
import hmac
import time

# ------------------------------------------------
# Utility function
# ------------------------------------------------

def create_token(key, data):
    return hmac.new(
        key.encode(),
        data.encode(),
        hashlib.sha256
    ).hexdigest()


# ------------------------------------------------
# Keys
# ------------------------------------------------

client_key = "client_secret"
tgs_key = "tgs_secret"
server_key = "server_secret"


# ------------------------------------------------
# Authentication Server
# ------------------------------------------------

def authentication_server(client_id):
    timestamp = str(int(time.time()))

    data = client_id + "|" + timestamp

    ticket = create_token(client_key, data)

    return {
        "client_id": client_id,
        "timestamp": timestamp,
        "ticket": ticket
    }


# ------------------------------------------------
# Ticket Granting Server
# ------------------------------------------------

def ticket_granting_server(tgt, service_id):

    client_id = tgt["client_id"]
    timestamp = tgt["timestamp"]
    ticket = tgt["ticket"]

    # Validate TGT
    expected_ticket = create_token(
        client_key,
        client_id + "|" + timestamp
    )

    if not hmac.compare_digest(ticket, expected_ticket):
        return None

    # Check ticket lifetime
    current_time = int(time.time())

    if current_time - int(timestamp) > 30:
        print("TGT expired")
        return None

    # Generate service ticket
    service_data = (
        client_id + "|" +
        service_id + "|" +
        str(current_time)
    )

    service_ticket = create_token(
        server_key,
        service_data
    )

    return {
        "client_id": client_id,
        "service_id": service_id,
        "timestamp": str(current_time),
        "ticket": service_ticket
    }


# ------------------------------------------------
# Service Server
# ------------------------------------------------

def service_server(service_ticket):

    client_id = service_ticket["client_id"]
    service_id = service_ticket["service_id"]
    timestamp = service_ticket["timestamp"]
    ticket = service_ticket["ticket"]

    # Recreate expected ticket
    data = (
        client_id + "|" +
        service_id + "|" +
        timestamp
    )

    expected_ticket = create_token(
        server_key,
        data
    )

    if not hmac.compare_digest(ticket, expected_ticket):
        return False

    # Check timestamp
    current_time = int(time.time())

    if current_time - int(timestamp) > 30:
        return False

    return True


