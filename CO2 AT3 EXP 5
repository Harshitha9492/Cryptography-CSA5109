def derive_key(shared_point):
    if shared_point is None:
        raise ValueError(
            "Invalid shared point"
        )

    x, y = shared_point

    data = (
        str(x) + ":" + str(y)
    ).encode()

    return hashlib.sha256(data).hexdigest()


# ------------------------------------------------------------
# Find a valid base point
# ------------------------------------------------------------

G = None

for x in range(1, P):

    rhs = (
        x ** 3
        + A * x
        + B
    ) % P

    for y in range(1, P):

        if (y * y) % P == rhs:
            G = (x, y)
            break

    if G is not None:
        break


print("Elliptic Curve")
print("--------------")
print("p =", P)
print("a =", A)
print("b =", B)
print("Base Point G =", G)

print("\nBase Point On Curve:",
      is_on_curve(G))


