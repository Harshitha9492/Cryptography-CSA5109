# Educational elliptic-curve implementation
# Demonstrates:
# - Correct point addition
# - Point doubling
# - Point at infinity
# - Modular inverse
# - Double-and-add scalar multiplication
# - ECDH shared-key generation
#
# Curve:
# y^2 = x^3 + ax + b (mod p)

import hashlib


# Small curve for demonstration only
P = 9739
A = 497
B = 1768


# Point at infinity
INFINITY = None


def is_on_curve(point):
    if point is None:
        return True

    x, y = point

    left = (y * y) % P

    right = (
        x * x * x
        + A * x
        + B
    ) % P

    return left == right


def modular_inverse(k):
    k %= P

    if k == 0:
        raise ZeroDivisionError(
            "No modular inverse"
        )

    return pow(k, P - 2, P)


def point_add(P1, P2):

    # P + infinity = P
    if P1 is None:
        return P2

    # infinity + P = P
    if P2 is None:
        return P1

    x1, y1 = P1
    x2, y2 = P2

    # P + (-P) = infinity
    if x1 == x2 and (y1 + y2) % P == 0:
        return None

    # Point doubling
    if P1 == P2:

        if y1 % P == 0:
            return None

        numerator = (
            3 * x1 * x1 + A
        ) % P

        denominator = (
            2 * y1
        ) % P

    # Ordinary point addition
    else:

        numerator = (
            y2 - y1
        ) % P

        denominator = (
            x2 - x1
        ) % P

    slope = (
        numerator *
        modular_inverse(denominator)
    ) % P

    x3 = (
        slope * slope
        - x1
        - x2
    ) % P

    y3 = (
        slope * (x1 - x3)
        - y1
    ) % P

    result = (x3, y3)

    if not is_on_curve(result):
        raise ValueError(
            "Point addition error"
        )

    return result


def scalar_multiply(k, point):

    if k == 0 or point is None:
        return None

    if k < 0:
        raise ValueError(
            "Scalar must be positive"
        )

    result = None
    current = point

    # Double-and-add optimization
    while k > 0:

        if k & 1:
            result = point_add(
                result,
                current
            )

        current = point_add(
            current,
            current
        )

        k >>= 1

    return result


