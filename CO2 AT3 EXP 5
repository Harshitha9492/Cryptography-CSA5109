bob_private = 456
bob_public = scalar_multiply(
    bob_private,
    G
)


print("\nAlice Private Key:", alice_private)
print("Alice Public Key :", alice_public)

print("\nBob Private Key:", bob_private)
print("Bob Public Key :", bob_public)


# ------------------------------------------------------------
# ECDH Shared Secret
# ------------------------------------------------------------

alice_shared = scalar_multiply(
    alice_private,
    bob_public
)

bob_shared = scalar_multiply(
    bob_private,
    alice_public
)


print("\nAlice Shared Point:")
print(alice_shared)

print("\nBob Shared Point:")
print(bob_shared)

print("\nShared Points Match:",
      alice_shared == bob_shared)


# ------------------------------------------------------------
# Derived symmetric key
# ------------------------------------------------------------

if alice_shared == bob_shared:

    alice_key = derive_key(
        alice_shared
    )

    bob_key = derive_key(
        bob_shared
    )

    print("\nAlice Derived Key:")
    print(alice_key)

    print("\nBob Derived Key:")
    print(bob_key)

    print("\nKeys Match:",
          alice_key == bob_key)


